{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.transcriber.invalid/contracts/asr-model-manifest.schema.json",
  "title": "ASR Model Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "display_name",
    "source_url",
    "execution_provider",
    "capabilities",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/stableId"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "execution_provider": {
      "$ref": "#/$defs/stableId"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "language"],
      "properties": {
        "context": {
          "type": "boolean"
        },
        "language": {
          "enum": ["optional", "required"]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "files"],
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
        },
        "files": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
